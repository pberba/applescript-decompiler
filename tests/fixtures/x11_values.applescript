property L : {1, 2.5, -3, "x", {a:1}}
property R : {p:true}
property D : missing value
copy L to M
set N to a reference to L
set q to item 1 of N
set R to my L
set s to result
set t to (ASCII character 65)
set u to pi
set v to tab & return & linefeed & space
set w to 1.5E+20
set x to -2.5
return t

