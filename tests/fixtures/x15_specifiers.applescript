set L to {1, 2, 3}
set m to middle item of L
set b to beginning of L
set c to some item of L
set d to item 2 of {4, 5}
set e to text 1 thru 3 of "hello"
set f to characters of "ab"
set g to every item of L
set h to (items of L)
set i to L as list
set j to (count L)
set k to length of L
set n to item 1 of L
return {m, b, d}

